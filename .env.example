# ==============================================================================
# Rebase Multi-Agent Legacy Code Modernization Platform
# Root Environment Template (For GitHub Repository)
# Copy this file to .env before starting services:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development               # Options: development, staging, production, testing
DEBUG=true                            # Set to false in production
PROJECT_NAME="Multi-Agent Legacy Code Modernization Platform API"
VERSION=1.0.0
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 2. Security & Session Authentication
# ------------------------------------------------------------------------------
# Generate a cryptographically secure random string for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_cryptographic_random_key_in_production
SESSION_COOKIE_NAME=rebase_session_id
SESSION_MAX_AGE_SECONDS=86400         # 24 hours
SESSION_COOKIE_SECURE=false           # Set true under HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 3. Frontend & Network Boundaries
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
VITE_API_BASE_URL=/api/v1
VITE_PORT=3000

# ------------------------------------------------------------------------------
# 4. Persistence & State Storage (PostgreSQL & Redis for Phase 1)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rebase_db
REDIS_URL=redis://localhost:6379/0
ARTIFACT_STORAGE_PATH=./artifacts     # Local directory or S3 bucket path

# ------------------------------------------------------------------------------
# 5. Multi-Agent LLM Model Keys & Guardrails
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_JOB_BUDGET_INR=15000.0        # Max autonomous budget (INR / Rupees) per job
DEFAULT_JOB_BUDGET_USD=15000.0        # Legacy alias for job budget ceiling (Rupees)
MAX_REPAIR_ATTEMPTS=3                 # Max module compile/test repair iterations
TOKEN_VELOCITY_LIMIT_PER_MINUTE=100000

# ------------------------------------------------------------------------------
# 6. Container Sandboxing & Security Governance
# ------------------------------------------------------------------------------
E2B_API_KEY=your_e2b_api_key_here
SANDBOX_RUNTIME=gVisor-rootless       # Options: gVisor-rootless, docker-rootless
SANDBOX_NETWORK_EGRESS=air-gapped     # Options: air-gapped, package-whitelist
ENFORCE_SECRET_REDACTION=true
MIN_RATIONALE_LENGTH=10

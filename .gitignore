# ==============================================================================
# Git Ignore Configuration for Rebase Platform
# ==============================================================================

# 1. Environment Files & Secrets (CRITICAL: Never commit to GitHub)
.env
.env.*
*.env
**/.env
**/.env.*
!*.env.example
!**/.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
*.credentials
.cloudflared/
**/.cloudflared/

# 2. Python & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
**/env/
venv/
**/venv/
.venv/
**/.venv/
ENV/
**/ENV/
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg


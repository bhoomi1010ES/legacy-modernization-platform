# ==============================================================================
# Git Ignore Configuration for Rebase Platform
# ==============================================================================

# Environment files & Secrets (NEVER commit .env to GitHub)
.env
.env.local
.env.*.local
*.env
!*.env.example

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Node.js & Frontend Build Outputs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
frontend/node_modules/
.output/

# IDE & OS Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local Artifacts & Sandboxes
artifacts/
repo_workspaces/
*.log
scratch/

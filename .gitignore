.pytest_cache/
**/.pytest_cache/
.pytest_temp/
**/.pytest_temp/
.test_runs/
**/.test_runs/
w09-safe-test-temp/
**/w09-safe-test-temp/
temp_pytest_run/
**/temp_pytest_run/
backups/
**/backups/
converted_projects/
**/converted_projects/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
test-results/
playwright-report/
.nyc_output/


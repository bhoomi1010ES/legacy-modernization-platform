# ==============================================================================
# Rebase Modernization Platform — Environment Configuration Template
# Copy this file to .env and configure values for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development               # Options: development, staging, production, testing
DEBUG=true                            # Set to false in staging and production
PROJECT_NAME="Multi-Agent Legacy Code Modernization Platform API"
VERSION=1.0.0
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 2. Security & Session Authentication
# ------------------------------------------------------------------------------
# CRITICAL: Generate a cryptographically random string (min 32 bytes) for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_cryptographic_random_key_in_production
SESSION_COOKIE_NAME=rebase_session_id
SESSION_MAX_AGE_SECONDS=86400         # 24 hours
SESSION_COOKIE_SECURE=false           # Set to true when serving behind HTTPS
SESSION_COOKIE_HTTPONLY=true          # Prevent client-side script access
SESSION_COOKIE_SAMESITE=lax           # Options: lax, strict, none

# ------------------------------------------------------------------------------
# 3. CORS & Host Boundary Whitelisting
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ------------------------------------------------------------------------------
# 4. Database & State Store (PostgreSQL & Redis for Phase 1 Persistence)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rebase_db
REDIS_URL=redis://localhost:6379/0
ARTIFACT_STORAGE_PATH=./artifacts     # S3 URI (s3://bucket/path) or local path

# ------------------------------------------------------------------------------
# 5. Autonomous Multi-Agent LLM Model Providers
# ------------------------------------------------------------------------------
# Anthropic API Key for Architect, CodeWriter, and Verifier specialist agents
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Autonomous Guardrails
DEFAULT_JOB_BUDGET_USD=150.0          # Hard cap on autonomous spend per modernization job
MAX_REPAIR_ATTEMPTS=3                 # Max inner-loop compile/test repair iterations
TOKEN_VELOCITY_LIMIT_PER_MINUTE=100000

# ------------------------------------------------------------------------------
# 6. Container Sandboxing & Security Governance
# ------------------------------------------------------------------------------
SANDBOX_RUNTIME=gVisor-rootless       # Options: gVisor-rootless, docker-rootless
SANDBOX_NETWORK_EGRESS=air-gapped     # Options: air-gapped, package-whitelist
ENFORCE_SECRET_REDACTION=true         # Masks credentials and API keys in artifact logs
MIN_RATIONALE_LENGTH=10               # Minimum character count for human approval gates

# Phase 6: values are administrator configuration, never accepted from API callers.
# See docs/phase-6/implementation-and-acceptance.md before enabling execution.
PHASE6_MODEL_PROVIDER=
PHASE6_MODEL_IDENTIFIER=
PHASE6_SANDBOX_IMAGE=
PHASE6_SANDBOX_PYTHON=/usr/local/bin/python
PHASE6_TARGET_COMMAND_JSON=[]
PHASE6_CHECK_COMMANDS_JSON=[]
PHASE6_SANDBOX_TIMEOUT=180
PHASE6_MAX_OUTPUT_TOKENS=8192
PHASE6_MAX_TASK_COST_USD=1.0
